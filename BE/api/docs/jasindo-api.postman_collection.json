        {
          "name": "Login rate limit (-> 429 with Retry-After)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 429) {",
                  "  pm.test('Retry-After header present', () => pm.response.to.have.header('Retry-After'));",
                  "  pm.test('X-RateLimit-Limit header present', () => pm.response.to.have.header('X-RateLimit-Limit'));",
                  "} else {",
                  "  pm.test('pre-429 attempts return 422', () => pm.response.to.have.status(422));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
